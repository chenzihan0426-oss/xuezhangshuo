# ============ Supabase ============
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============ 通义千问(阿里云灵积 DashScope) ============
# embedding 用于背景向量匹配;qwen-plus + 联网搜索用于 AI 行业动态/薪资简报
DASHSCOPE_API_KEY=sk-xxx
TONGYI_EMBED_MODEL=text-embedding-v2
TONGYI_BRIEF_MODEL=qwen-plus
# 设为 1 才用真实通义向量做匹配(默认走 hash,与现有 senior_paths 向量保持一致)
# TONGYI_REAL_EMBED=0

# ============ Chroma(向量库) ============
# 本地容器:CHROMA_URL=http://localhost:8000
# 也可改为 pgvector(直接走 Supabase),此时不需要 Chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=senior_paths

# ============ 应用 ============
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=学长说

# ============ 微信/支付宝(V1.5)============
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ============ 监控 ============
# 留空则不启用 Sentry,不影响构建
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Vercel Analytics & Speed Insights 在 Vercel 部署时自动启用,本地无需配置
